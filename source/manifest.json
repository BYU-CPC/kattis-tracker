{
	"name": "Kattis Tracker",
	"version": "0.0.3",
	"description": "Kattis Submission Tracker",
	"homepage_url": "https://github.com/joshbtay/kattis-extension",
	"manifest_version": 3,
	"browser_specific_settings": {
		"gecko": {
			"id": "joshbtay@gmail.com",
			"data_collection_permissions": {
				"required": ["personallyIdentifyingInfo", "websiteActivity", "websiteContent"]
			}
		}
	},
	"icons": {
		"120": "icon.png"
	},
	"permissions": ["storage"],
	"host_permissions": ["https://*.kattis.com/*"],
	"content_scripts": [
		{
			"matches": ["https://*.kattis.com/*"],
			"js": ["content.js"],
			"css": ["content.css"],
			"run_at": "document_end"
		}
	],
	"options_ui": {
		"page": "options.html"
	}
}
